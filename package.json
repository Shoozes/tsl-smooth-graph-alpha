{
  "name": "@ours/forcegraph-tsl",
  "version": "0.3.0-alpha.1",
  "description": "Headless deterministic force graphs with an injected Three.js and TSL rendering adapter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shoozes/tsl-smooth-graph-alpha.git"
  },
  "homepage": "https://github.com/Shoozes/tsl-smooth-graph-alpha#readme",
  "bugs": {
    "url": "https://github.com/Shoozes/tsl-smooth-graph-alpha/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "sideEffects": false,
  "files": [
    "dist",
    "source/**/*.ts",
    "THIRD_PARTY_NOTICES.md",
    "docs/licenses/three-MIT.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./three": {
      "types": "./dist/platform/three/index.d.ts",
      "import": "./dist/platform/three/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./labels": {
      "types": "./dist/labels/index.d.ts",
      "import": "./dist/labels/index.js"
    },
    "./camera": {
      "types": "./dist/camera/index.d.ts",
      "import": "./dist/camera/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && tsc --project tsconfig.test.json && node scripts/run-tests.mjs",
    "test:examples": "npm run build && node scripts/run-tests.mjs --examples",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run test && npm run check:docs",
    "showcase": "npm run build && node scripts/showcase-server.mjs",
    "pack:release": "node scripts/pack.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "build:pages": "npm run build && node scripts/build-pages.mjs"
  },
  "peerDependencies": {
    "three": "^0.185.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/three": "0.185.0",
    "three": "0.185.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "three",
    "tsl",
    "webgpu",
    "force-graph",
    "graph"
  ],
  "license": "MIT"
}
